#!/usr/bin/osascript -l JavaScript
// Command-line client for Apple Reminders, through EventKit. It follows the
// task provider contract of the sidecar Tasks tab:
//   tasks [--completed-since DATE]
//   add LIST [--due DATE] [--notes TEXT] [--priority P] TITLE
//   update LIST TASK [--title TEXT] [--due DATE] [--notes TEXT] [--status STATUS] [--priority P]
//   move LIST TASK NEWLIST
//   delete LIST TASK
//   login
// Lists are Reminders lists and tasks are reminders, by identifier. Each task
// also has "recurring", true when it has a recurrence rule, and "priority",
// the Priority field as "A" (High), "B" (Medium), "C" (Low) or null; P is one
// of those or "none". Reminders has no subtasks in EventKit, so --parent is
// refused. EventKit can't change a saved reminder's list, so move copies it
// to NEWLIST and deletes the original, and prints the copy's {"id"}. Without
// access to Reminders, it prints {"error": "auth_required"} and exits with
// code 3.
ObjC.import("EventKit");
ObjC.import("Foundation");
ObjC.import("stdlib");

const store = $.EKEventStore.alloc.init;
const FULL_ACCESS = 3;

/** Waits on the run loop until done() is true, for up to the given seconds. */
function wait(done, seconds) {
  const until = $.NSDate.dateWithTimeIntervalSinceNow(seconds);
  while (!done() && $.NSDate.date.compare(until) < 0) {
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.05));
  }
}

function authorized() {
  return Number($.EKEventStore.authorizationStatusForEntityType($.EKEntityTypeReminder)) === FULL_ACCESS;
}

/** Prints the sign-in answer on standard output and exits with code 3. */
function auth_required() {
  const out = $.NSFileHandle.fileHandleWithStandardOutput;
  out.writeData($(JSON.stringify({ error: "auth_required" }) + "\n").dataUsingEncoding($.NSUTF8StringEncoding));
  $.exit(3);
}

/** Splits arguments into the values of the named options and the rest. */
function options(args, names) {
  const values = {}, rest = [];
  for (let i = 0; i < args.length; i++) {
    const name = args[i].startsWith("--") ? args[i].slice(2) : null;
    if (name !== null && names.includes(name)) {
      if (i + 1 >= args.length) throw new Error("Missing value for --" + name);
      values[name] = args[++i];
    } else {
      rest.push(args[i]);
    }
  }
  return { values, rest };
}

function pad(n) {
  return (n < 10 ? "0" : "") + n;
}

/** The local date of an NSDate as YYYY-MM-DD. */
function local_date(date) {
  const formatter = $.NSDateFormatter.alloc.init;
  formatter.dateFormat = "yyyy-MM-dd";
  return ObjC.unwrap(formatter.stringFromDate(date));
}

/** NSDateComponents for a YYYY-MM-DD date, or nil for an empty one. */
function components(date) {
  if (!date) return $();
  const parts = date.split("-").map(Number);
  const c = $.NSDateComponents.alloc.init;
  c.year = parts[0];
  c.month = parts[1];
  c.day = parts[2];
  return c;
}

function fetch(predicate) {
  let items = null;
  store.fetchRemindersMatchingPredicateCompletion(predicate, function (found) {
    items = found;
  });
  wait(function () { return items !== null; }, 20);
  const out = [];
  for (let i = 0; items && i < items.count; i++) out.push(items.objectAtIndex(i));
  return out;
}

/** EventKit's priority: 1 to 4 is High, 5 Medium, 6 to 9 Low, 0 none. */
function rating(priority) {
  const n = Number(priority);
  return n >= 1 && n <= 4 ? "A" : n === 5 ? "B" : n >= 6 ? "C" : null;
}

const priorities = { A: 1, B: 5, C: 9, none: 0 };

function priority(value) {
  if (!(value in priorities)) throw new Error("Priority is A, B, C or none: " + value);
  return priorities[value];
}

function task_fields(r) {
  const due = r.dueDateComponents;
  const rules = r.recurrenceRules;
  return {
    id: ObjC.unwrap(r.calendarItemIdentifier),
    title: ObjC.unwrap(r.title) || "",
    due: due.isNil() ? "" : due.year + "-" + pad(due.month) + "-" + pad(due.day),
    notes: r.hasNotes ? ObjC.unwrap(r.notes) : "",
    parent: null,
    status: r.completed ? "completed" : "needsAction",
    completed: r.completed && !r.completionDate.isNil() ? local_date(r.completionDate) : null,
    recurring: !rules.isNil() && rules.count > 0,
    priority: rating(r.priority),
    created: r.creationDate.isNil() ? 0 : r.creationDate.timeIntervalSince1970,
  };
}

function command_tasks(args) {
  const values = options(args, ["completed-since"]).values;
  const calendars = store.calendarsForEntityType($.EKEntityTypeReminder);
  const output = [];
  for (let i = 0; i < calendars.count; i++) {
    const calendar = calendars.objectAtIndex(i);
    const scope = $.NSArray.arrayWithObject(calendar);
    // Reminders keeps no manual order that EventKit exposes, so the oldest come first.
    const tasks = fetch(store.predicateForIncompleteRemindersWithDueDateStartingEndingCalendars($(), $(), scope))
      .map(task_fields).sort(function (a, b) { return a.created - b.created; });
    if (values["completed-since"]) {
      const parts = values["completed-since"].split("-").map(Number);
      const start = $.NSCalendar.currentCalendar.dateWithEraYearMonthDayHourMinuteSecondNanosecond(1, parts[0], parts[1], parts[2], 0, 0, 0, 0);
      fetch(store.predicateForCompletedRemindersWithCompletionDateStartingEndingCalendars(start, $(), scope))
        .forEach(function (r) { tasks.push(task_fields(r)); });
    }
    tasks.forEach(function (t) { delete t.created; });
    output.push({ id: ObjC.unwrap(calendar.calendarIdentifier), title: ObjC.unwrap(calendar.title), tasks: tasks });
  }
  return JSON.stringify(output);
}

function save(reminder) {
  const error = $();
  if (!store.saveReminderCommitError(reminder, true, error)) {
    throw new Error("Saving the reminder failed");
  }
}

function command_add(args) {
  const parsed = options(args.slice(1), ["due", "notes", "parent", "previous", "priority"]);
  if (parsed.values.parent) throw new Error("Apple Reminders has no subtasks for other programs; steps are not supported.");
  const calendar = store.calendarWithIdentifier(args[0]);
  if (calendar.isNil()) throw new Error("No such list: " + args[0]);
  const reminder = $.EKReminder.reminderWithEventStore(store);
  reminder.calendar = calendar;
  reminder.title = parsed.rest.join(" ");
  if (parsed.values.due) reminder.dueDateComponents = components(parsed.values.due);
  if (parsed.values.notes !== undefined) reminder.notes = parsed.values.notes;
  if (parsed.values.priority !== undefined) reminder.priority = priority(parsed.values.priority);
  save(reminder);
  return JSON.stringify({ id: ObjC.unwrap(reminder.calendarItemIdentifier) });
}

function command_update(args) {
  const values = options(args.slice(2), ["title", "due", "notes", "status", "priority"]).values;
  const reminder = store.calendarItemWithIdentifier(args[1]);
  if (reminder.isNil()) throw new Error("No such task: " + args[1]);
  if (values.title !== undefined) reminder.title = values.title;
  if (values.due !== undefined) reminder.dueDateComponents = components(values.due);
  if (values.notes !== undefined) reminder.notes = values.notes;
  if (values.status !== undefined) reminder.completed = values.status === "completed";
  if (values.priority !== undefined) reminder.priority = priority(values.priority);
  save(reminder);
  return "updated";
}

/** Copies a reminder to another list and deletes the original: its title,
 * notes, link, due date, priority, repeats and alarms. Attachments, tags and
 * subtasks made in Apple's app aren't open to other programs. */
function command_move(args) {
  const reminder = store.calendarItemWithIdentifier(args[1]);
  if (reminder.isNil()) throw new Error("No such task: " + args[1]);
  const calendar = store.calendarWithIdentifier(args[2]);
  if (calendar.isNil()) throw new Error("No such list: " + args[2]);
  const copy = $.EKReminder.reminderWithEventStore(store);
  copy.calendar = calendar;
  copy.title = reminder.title;
  if (reminder.hasNotes) copy.notes = reminder.notes;
  if (!reminder.URL.isNil()) copy.URL = reminder.URL;
  if (!reminder.dueDateComponents.isNil()) copy.dueDateComponents = reminder.dueDateComponents;
  copy.priority = reminder.priority;
  const rules = reminder.recurrenceRules;
  for (let i = 0; !rules.isNil() && i < rules.count; i++) copy.addRecurrenceRule(rules.objectAtIndex(i).copy);
  const alarms = reminder.alarms;
  for (let i = 0; !alarms.isNil() && i < alarms.count; i++) copy.addAlarm(alarms.objectAtIndex(i).copy);
  save(copy);
  if (!store.removeReminderCommitError(reminder, true, $())) {
    throw new Error("The copy was saved, but deleting the original failed");
  }
  return JSON.stringify({ id: ObjC.unwrap(copy.calendarItemIdentifier) });
}

function command_delete(args) {
  const reminder = store.calendarItemWithIdentifier(args[1]);
  if (reminder.isNil()) throw new Error("No such task: " + args[1]);
  if (!store.removeReminderCommitError(reminder, true, $())) throw new Error("Deleting the reminder failed");
  return "deleted";
}

function command_login() {
  let answer = null;
  store.requestFullAccessToRemindersWithCompletion(function (granted) {
    answer = granted;
  });
  wait(function () { return answer !== null; }, 120);
  if (!authorized()) throw new Error("Access to Reminders was not granted. Allow it in System Settings, Privacy and Security, Reminders.");
  return "signed in";
}

function dispatch(command, args) {
  if (command === "login") return command_login();
  if (!authorized()) auth_required();
  if (command === "tasks") return command_tasks(args);
  if (command === "add") return command_add(args);
  if (command === "update") return command_update(args);
  if (command === "move") return command_move(args);
  if (command === "delete") return command_delete(args);
  throw new Error("Commands: tasks, add, update, move, delete, login");
}

/** Prints the result on standard output, or an error's message on standard
 * error with exit code 1. */
function run(argv) {
  try {
    return dispatch(argv[0], argv.slice(1));
  } catch (error) {
    console.log(error.message);
    $.exit(1);
  }
}
